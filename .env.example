# Django / Render Web Service
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for local SQLite. For free hosted deployments, set this in Render
# from an external PostgreSQL provider such as Neon or Supabase.
DATABASE_URL=

# React / Vercel origins that are allowed to call the Django API.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vercel proxies /api to Render: cookies stay host-only (no Domain) with Path=/.
# SameSite=Lax works in production and local development.
# Set both Secure values to True in production (DEBUG=False also defaults to True).
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
